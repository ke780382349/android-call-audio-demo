<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pcmConfigRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/pcmConfigTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pcmSelectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#14000000"
            android:padding="12dp"
            android:text="@string/no_pcm_selected"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/pcmOperationStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pcm_config_idle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/refreshPcmListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/refresh_pcm_list" />

        <TextView
            android:id="@+id/pcmEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/no_pcm_files"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <LinearLayout
            android:id="@+id/pcmListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
